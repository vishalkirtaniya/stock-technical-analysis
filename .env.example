# Supabase: Project Settings -> Database -> Connection string
# Use the "Session pooler" string (works over IPv4, supports everything we need).
# If your password has special characters (@ : / # ?), URL-encode them.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Candle size: 1d recommended to start (Yahoo limits intraday history)
INTERVAL=1d
# How far back to go on the very first fetch of a symbol
HISTORY_START=2010-01-01
# On updates, re-fetch this many days before the last stored candle
# (fixes partial candles / late corrections)
OVERLAP_DAYS=5
# Pause between Yahoo requests (seconds)
REQUEST_DELAY=0.5
API_KEY=pblaplabplab